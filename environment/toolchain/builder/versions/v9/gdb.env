# Versions for the gdb stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
GDB_VERSION=17.2
# sourceware publishes sha512 rather than sha256 for gdb. Pinned here like
# every other digest: fetching the checksum file from the same server as the
# tarball proves only that the two agree.
GDB_SHA512="2e6a4d59632f1841500d8e57d900eb78eefe73e808ea80a98935ca9988ec3e36a622158ead9af3de0968b82c64244010c0103d56b22b123f5de5e7a39d11da14"
