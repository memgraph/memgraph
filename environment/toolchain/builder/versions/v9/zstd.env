# Versions for the zstd stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
#
# In the sysroot so LLVM can be built against it: without zstd, clang refuses
# -gz=zstd outright and debug compression falls back to zlib.
ZSTD_VERSION=1.5.7
ZSTD_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
