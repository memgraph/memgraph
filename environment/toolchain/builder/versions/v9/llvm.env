# Versions for the llvm stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
LLVM_VERSION=22.1.8
# The commit llvmorg-22.1.8 pointed at. The tag is what gets cloned, because
# that keeps the clone shallow; this is what the result is checked against.
LLVM_COMMIT=ca7933e47d3a3451d81e72ac174dcb5aa28b59d1

# What this LLVM ships. Declared here rather than in the recipe because the
# README names it too, and a list retyped in two places is one that disagrees.
#
# compiler-rt and openmp are runtimes rather than projects: they have been
# deprecated as projects since LLVM 16 and are built by the just-built clang,
# not the host gcc. bolt gives llvm-bolt, perf2bolt and merge-fdata, and is a
# project rather than a separate download, so the only cost is build time.
LLVM_PROJECTS="clang;clang-tools-extra;lldb;lld;bolt"
LLVM_RUNTIMES="libunwind;compiler-rt;openmp"
