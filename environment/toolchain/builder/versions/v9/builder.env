# Where this toolchain is built, and so where the toolchain itself can run.
#
# Distinct from the floors in glibc.env and linux-headers.env, which say where
# a binary *compiled with* this toolchain can run. These two move for different
# reasons and are easy to conflate, because today both glibc numbers are close
# together.
#
# The base image sets the builder's glibc, so the two below are one decision
# and belong next to each other: raising the image without raising the floor
# means the check passes while the toolchain has already stopped running on the
# oldest machine anyone runs it on.
#
# The builder must stay no newer than the oldest distro anyone runs the
# toolchain on, which is not the same list as the distros we package memgraph
# for.
BASE_IMAGE=ubuntu@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214
TC_BUILDER_GLIBC_FLOOR=2.31

# Names the build environment, so it has to describe the base image: binutils
# keys a gprofng workaround off it, and the generated README points at this
# distro's run-dependency list.
TC_DISTRO=ubuntu-20.04
