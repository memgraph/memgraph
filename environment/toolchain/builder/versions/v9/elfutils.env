# Versions for the elfutils stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
#
# libelf and libdw in the sysroot: dwz and libabigail both read DWARF, and
# linking them against the host's copies would break the glibc floor.
ELFUTILS_VERSION=0.196
ELFUTILS_SHA256="fd5cc6b77ad6773cac93cb3f415f9318ac3b3455eecf801f6b4a742c4f6c7209"
