# Versions for the linux-headers stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
#
# The sysroot's UAPI headers, and the source of the kernel floor: glibc's
# --enable-kernel is derived from this. 5.14 is CentOS Stream 9's kernel.
LINUX_HEADERS_VERSION=5.14.21
LINUX_HEADERS_SHA256="f41a259cb2002dd2e3286524b2bb4e803f4f982992d092706ecea613584023b3"
