# Versions for the glibc stage. Bumping one here rebuilds this stage
# and everything downstream of it, and nothing else.
#
# This is the sysroot glibc: it decides the oldest system a binary built with
# this toolchain will run on. 2.34 is CentOS Stream 9's, the oldest of any
# distro we package for.
GLIBC_VERSION=2.34
GLIBC_SHA256="44d26a1fe20b8853a48f470ead01e4279e869ac149b195dda4e44a195d981ab2"
