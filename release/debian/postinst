#!/bin/sh
# postinst script for memgraph
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # Add the 'memgraph' user and group and set permissions on
        # 'var/*/memgraph' directories. useradd (essential passwd package)
        # rather than adduser; getent guards keep upgrades idempotent.
        getent group memgraph >/dev/null || groupadd --system memgraph || exit 1
        getent passwd memgraph >/dev/null || \
            useradd --system --gid memgraph --home-dir /var/lib/memgraph \
                --no-create-home --shell /bin/bash memgraph || exit 1
        echo "Don't forget to switch to the 'memgraph' user to use Memgraph" || exit 1
        chown memgraph:memgraph /var/lib/memgraph || exit 1
        chmod 750 /var/lib/memgraph || exit 1
        chown memgraph:adm /var/log/memgraph || exit 1
        chmod 750 /var/log/memgraph || exit 1

        # Generate SSL certificates
        if [ ! -d /etc/memgraph/ssl ]; then
            mkdir /etc/memgraph/ssl || exit 1
            openssl req -x509 -newkey rsa:4096 -days 3650 -nodes \
                -keyout /etc/memgraph/ssl/key.pem -out /etc/memgraph/ssl/cert.pem \
                -subj "/C=GB/ST=London/L=London/O=Memgraph Ltd./CN=Memgraph DB" || exit 1
            chown memgraph:memgraph /etc/memgraph/ssl/* || exit 1
            chmod 400 /etc/memgraph/ssl/* || exit 1
        fi

        # The memgraph binary is built against the Python stable ABI (abi3) and
        # its DT_NEEDED is rewritten to the unversioned SONAME `libpython3.so`,
        # so it can load against any libpython3 >= 3.10. Debian/Ubuntu ship only
        # versioned libpython files, so point `libpython3.so` at the
        # highest-numbered installed libpython3.X.so.1.0. The glob covers the
        # multiarch dir (e.g. x86_64-linux-gnu), /usr/lib64 and /usr/lib without
        # needing dpkg-architecture (dpkg-dev is not present on runtime hosts).
        target="$(ls -1 /usr/lib/*/libpython3.*.so.1.0 /usr/lib64/libpython3.*.so.1.0 /usr/lib/libpython3.*.so.1.0 2>/dev/null | sort -V | tail -1)"
        if [ -n "$target" ]; then
            libdir="$(dirname "$target")"
            # Skip (leave as-is) if something already provides libpython3.so.
            if [ ! -e "$libdir/libpython3.so" ]; then
                ln -sf "$(basename "$target")" "$libdir/libpython3.so"
                ldconfig || true
            fi
        fi

        # Python deps for the bundled query modules (nxalg, wcc,
        # graph_analyzer, node2vec_online, ...) and the auth/SSO modules,
        # pinned to the versions validated by the package smoke tests
        # (release/package/mgbuild.sh). numpy/scipy/pyyaml/xmlsec pins step
        # up with the Python version — the older pins ship no wheels for
        # newer interpreters (e.g. nothing below numpy 2.3 has cp314 wheels).
        # Installed --user as memgraph so the embedded interpreter (which
        # runs as memgraph) imports them from /var/lib/memgraph/.local.
        pyminor="$(python3 -c 'import sys; print(sys.version_info[1])')"
        numpy_version="1.26.4"; scipy_version="1.13.0"
        pyyaml_version="6.0.1"; xmlsec_version="1.3.16"
        if [ "$pyminor" -ge 14 ]; then
            numpy_version="2.5.1"; scipy_version="1.18.0"
            pyyaml_version="6.0.3"; xmlsec_version="1.3.17"
        elif [ "$pyminor" -eq 13 ]; then
            numpy_version="2.1.0"; scipy_version="1.15.0"
        fi
        pip_packages="cryptography==49.0.0 PyJWT==2.13.0 requests==2.32.5 \
ldap3==2.6 pyyaml==$pyyaml_version python3-saml==1.16.0 lxml==6.1.0 \
xmlsec==$xmlsec_version numpy==$numpy_version scipy==$scipy_version \
networkx==3.4.2"
        # Failure stays hard unless MEMGRAPH_OFFLINE_INSTALL=1 (the .run
        # installer pre-installs the wheels; see release/mage/postinst.in).
        if ! su - memgraph -c "PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install --user --no-cache-dir --no-warn-script-location $pip_packages"; then
            if [ "${MEMGRAPH_OFFLINE_INSTALL:-}" = "1" ]; then
                echo "WARNING: pip install of query module python deps failed;" >&2
                echo "         tolerated because MEMGRAPH_OFFLINE_INSTALL=1." >&2
            else
                echo "ERROR: failed to install python deps for query modules." >&2
                echo "       Check network connectivity and pip configuration, then retry." >&2
                exit 1
            fi
        fi
        # gssapi (Kerberos SSO only) ships no PyPI wheels; only attempt the
        # source build when its prerequisites are already present, so the
        # common case skips with one line instead of a pip traceback.
        if command -v krb5-config >/dev/null 2>&1 && command -v cc >/dev/null 2>&1; then
            su - memgraph -c "PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install --user --no-cache-dir --no-warn-script-location gssapi==1.11.1" || \
                echo "WARNING: python gssapi failed to build; Kerberos SSO will be unavailable." >&2
        else
            echo "NOTE: skipping python gssapi (only Kerberos SSO needs it); to enable," >&2
            echo "      install libkrb5-dev and a C compiler, then as memgraph run:" >&2
            echo "      python3 -m pip install --user gssapi==1.11.1" >&2
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# Always setup the systemd memgraph.service. The following was autogenerated
# by dh_systemd_enable and dh_systemd_start, so it should behave as expected.

# This will only remove masks created by d-s-h on package removal.
deb-systemd-helper unmask memgraph.service >/dev/null || true

# was-enabled defaults to true, so new installations run enable.
if deb-systemd-helper --quiet was-enabled memgraph.service; then
    # Enables the unit on first installation, creates new
    # symlinks on upgrades if the unit file has changed.
    deb-systemd-helper enable memgraph.service >/dev/null || true
else
    # Update the statefile to add new symlinks (if any), which need to be
    # cleaned up on purge. Also remove old symlinks.
    deb-systemd-helper update-state memgraph.service >/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    deb-systemd-invoke start memgraph.service >/dev/null || true
fi

# Take a look at the preinst script for the detailed explanation.
if dpkg-maintscript-helper supports rm_conffile 2>/dev/null; then
    dpkg-maintscript-helper rm_conffile /etc/logrotate.d/memgraph_audit 1.1.999 -- "$@"
fi

exit 0
