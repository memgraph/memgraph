# Wraps an already-built mgbench client binary (build/tests/mgbench/client)
# into the same runtime image layout as Dockerfile.mgbench_client, without
# rebuilding Memgraph. Build context must contain:
#   client   - the binary
#   lib/     - the toolchain's libstdc++.so.6 and libgcc_s.so.1 it was linked
#              against (newer than Ubuntu's; memgraph ships them the same way)
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y wget libcurl4 libatomic1 && \
    rm -rf /var/lib/apt/lists/*

COPY client /bin/client
COPY lib/ /opt/mgbench/lib/
ENV LD_LIBRARY_PATH=/opt/mgbench/lib

ENTRYPOINT ["/bin/client"]
