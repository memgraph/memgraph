[settings]
compiler.tsan=True

[conf]
tools.build:cflags+=["-fsanitize=thread", "-fno-omit-frame-pointer"]
tools.build:cxxflags+=["-fsanitize=thread", "-fno-omit-frame-pointer"]
tools.build:exelinkflags+=["-fsanitize=thread"]
tools.build:sharedlinkflags+=["-fsanitize=thread"]

[options]
# Static OpenSSL under sanitizers: an instrumented libcrypto.so on
# LD_LIBRARY_PATH breaks the autotools configure scripts of other conan
# dependencies during the build. Overrides "openssl/*:shared" in conanfile.py.
openssl/*:shared=False
