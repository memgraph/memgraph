include(memgraph_freebsd_base)

[settings]
compiler.cppstd=gnu23

[options]
# rocksdb's io_uring support is a Linux kernel interface; the option is what gates
# pulling liburing into the graph.
rocksdb/*:with_liburing=False

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:user_toolchain=["{{ os.path.join(os.getcwd(), 'environment', 'toolchain-freebsd.cmake') }}"]
