include(memgraph_freebsd_base)

[settings]
compiler.cppstd=gnu23

[options]
# There is no toolchain build for FreeBSD, so memgraph links the base system's C++
# runtime and ships nothing beside the binary. Saying it here means every entry point
# that reads this profile agrees, whether it is build.sh, `conan build` or a preset.
# The option is addressed by package name rather than as `&`, which would name whatever
# package a `conan install --requires=...` puts at the root and fail on its options.
memgraph/*:bundled_toolchain=False

# rocksdb's io_uring support is a Linux kernel interface; the option is what gates
# pulling liburing into the graph.
rocksdb/*:with_liburing=False

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:user_toolchain=["{{ os.path.join(os.getcwd(), 'environment', 'toolchain-freebsd.cmake') }}"]
