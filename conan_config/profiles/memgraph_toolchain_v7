include(memgraph_linux_base)

{% set toolchain_path = os.getenv("MG_TOOLCHAIN_ROOT", "/opt/toolchain-v7") %}

[settings]
compiler.version=20

[conf]
tools.cmake.cmaketoolchain:user_toolchain=["{{ os.path.join(os.getcwd(), 'environment', 'toolchain', 'v7', 'toolchain.cmake') }}"]
tools.build:compiler_executables={"c": "{{ os.path.join(toolchain_path, "bin/clang") }}", "cpp": "{{ os.path.join(toolchain_path, "bin/clang++") }}"}
