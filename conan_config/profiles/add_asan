[settings]
compiler.asan=True

[conf]
tools.build:cflags+=["-fsanitize=address", "-fno-omit-frame-pointer"]
tools.build:cxxflags+=["-fsanitize=address", "-fno-omit-frame-pointer"]
tools.build:exelinkflags+=["-fsanitize=address"]
tools.build:sharedlinkflags+=["-fsanitize=address"]

[options]
# Static OpenSSL under sanitizers: an instrumented libcrypto.so on
# LD_LIBRARY_PATH breaks the autotools configure scripts of other conan
# dependencies during the build. Overrides "openssl/*:shared" in conanfile.py.
openssl/*:shared=False
