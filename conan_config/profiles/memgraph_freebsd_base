{% set target_arch = {"amd64": "x86_64", "aarch64": "armv8"}.get(platform.machine(), platform.machine()) %}
{% set clang_version = detect_api.default_compiler_version("clang", detect_api.detect_clang_compiler("/usr/bin/cc")[1]) %}
{% set cmake_version = os.popen("cmake --version").read().split()[2] %}
{% set ninja_version = os.popen("ninja --version").read().strip() %}
{% set flex_version = os.popen("flex --version").read().split()[1] %}

# What the FreeBSD host and build profiles agree on. Each adds the C++ standard it needs,
# and the host profile adds what only applies to building memgraph itself.
#
# The compiler and the build tools belong to the host here rather than to a toolchain
# this repository builds, and they differ between FreeBSD releases: 15 carries clang 19
# where 16 carries clang 21. Reading the versions off the host is what lets one profile
# describe any of them, and it keeps conan's package ids computed for the compiler that
# will actually run. A missing tool surfaces as a render error; build.sh checks the
# packages this needs before it reaches conan.

[settings]
arch={{ target_arch }}
build_type=Release
compiler=clang
compiler.cstd=gnu17
compiler.libcxx=libc++
compiler.version={{ clang_version }}
os=FreeBSD

[conf]
tools.build:compiler_executables={"c": "/usr/bin/cc", "cpp": "/usr/bin/c++"}

# Both have GNU-only makefiles and FreeBSD's `make` is not GNU make, so name gmake for
# them. This must stay scoped to the packages that need it: CMakeToolchain also feeds
# tools.gnu:make_program into CMAKE_MAKE_PROGRAM, so setting it globally makes CMake run
# gmake as if it were ninja and every CMake-based dependency fails at configure time.
jemalloc/*:tools.gnu:make_program=gmake
libbcrypt/*:tools.gnu:make_program=gmake

# Taken from the host rather than built here. Conan matches each entry against what a
# recipe asks for, so it has to name the version the host really has, which is what the
# lines at the top read off. cmake is the one with no alternative: its conancenter recipe
# packages prebuilt binaries for Linux, macOS and Windows, and a FreeBSD build of it
# fails looking its own platform up in that list.
#
# openjdk names the version conan's antlr4 recipe requires. What runs is the host's JDK,
# which only has to be new enough for the antlr4 jar.
[platform_tool_requires]
cmake/{{ cmake_version }}
ninja/{{ ninja_version }}
flex/{{ flex_version }}
openjdk/21.0.1

# Memgraph pins a cmake newer than any FreeBSD port carries, and dependencies pin ranges
# below it. The host has one cmake, so every such requirement resolves to it.
[replace_tool_requires]
cmake/*: cmake/{{ cmake_version }}
